#!/usr/bin/env bash
# mkt CLI shim: runs the TypeScript sources directly (Node >= 22.12 + tsx). `mkt` alone opens the guided setup.
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"; [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"; done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

node_ok() { command -v node >/dev/null 2>&1 && node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>22||(a===22&&b>=12)?0:1)'; }
if ! node_ok && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh" >/dev/null
  nvm use 22 >/dev/null 2>&1 || true
fi
if ! node_ok; then
  echo "mkt needs Node.js 22.12 or newer: https://nodejs.org (or: brew install node@22, or: nvm install 22)" >&2
  exit 1
fi
if [ ! -f "$ROOT/node_modules/tsx/dist/loader.mjs" ]; then
  echo "Installing dependencies (first run)..." >&2
  (cd "$ROOT" && npm install --silent --no-fund --no-audit >&2)
fi
LOADER="$ROOT/node_modules/tsx/dist/loader.mjs"

# Everything except the guided setup and `open` replaces this shell (the MCP server must be the process its client
# talks to).
if [ $# -gt 0 ] && [ "$1" != "setup" ] && [ "$1" != "open" ]; then
  exec node --import "$LOADER" "$ROOT/src/cli.ts" "$@"
fi

# Guided setup / open: when they end by opening Claude Code or Codex, they write the command to MKT_HANDOFF and exit;
# this shell then becomes that agent, so the agent gets a clean terminal (no Node parent holding the TTY).
HANDOFF="${TMPDIR:-/tmp}/mkt-handoff-$$"
rm -f "$HANDOFF"
status=0
MKT_HANDOFF="$HANDOFF" node --import "$LOADER" "$ROOT/src/cli.ts" "$@" || status=$?
if [ -s "$HANDOFF" ]; then
  ARGS=()
  while IFS= read -r -d '' arg; do ARGS+=("$arg"); done < "$HANDOFF"
  rm -f "$HANDOFF"
  cd "$ROOT"
  exec "${ARGS[@]}"
fi
rm -f "$HANDOFF"
exit "$status"
