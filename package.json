{
  "name": "mkt-harness",
  "version": "0.1.0",
  "private": true,
  "description": "AI marketing harness for Claude Code and Codex: brand + customer understanding, trends, content, lead gen, outreach, inbox and multi-account posting through Chrome.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "mkt": "bin/mkt"
  },
  "scripts": {
    "mkt": "node --import tsx src/cli.ts",
    "mcp": "node --import tsx src/cli.ts mcp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "MKT_BROWSER_TESTS=1 vitest run tests/browser.test.ts",
    "readme:assets": "node --import tsx scripts/readme-assets.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "commander": "^15.0.0",
    "imapflow": "^2.0.8",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.11",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
