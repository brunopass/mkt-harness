# Copy to .env (gitignored). accounts.yaml references these by NAME, never by value.

# Email (transport: smtp). Gmail/Workspace: use an app password.
# MKT_SMTP_ACME=smtps://hello%40acme.com:app-password@smtp.gmail.com:465
# MKT_IMAP_ACME=imaps://hello%40acme.com:app-password@imap.gmail.com:993

# WhatsApp Business Cloud API (transport: whatsapp_cloud)
# MKT_WA_ACME_PHONE_ID=123456789012345
# MKT_WA_ACME_TOKEN=EAAG...

# Optional
# MKT_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# MKT_WORKSPACE=/path/to/another/workspace
